# SMS Surface environment variables

APP_NAME=SMS Surface
DEBUG=true

# BlueBubbles iMessage server
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=your_server_password
BLUEBUBBLES_CHAT_GUID=your_default_chat_guid

# CMUGPT Agent integration
# Choose one after the integration question is answered:
AGENT_API_URL=http://localhost:5000/agent/respond
AGENT_API_KEY=your_agent_shared_secret
# Set to true only if you import the agent package directly:
AGENT_DIRECT_IMPORT=false

# CMU Keycloak (fill in after Keycloak details are confirmed)
CMU_KEYCLOAK_URL=
CMU_KEYCLOAK_CLIENT_ID=
CMU_KEYCLOAK_CLIENT_SECRET=

# Database
DATABASE_URL=sqlite:///./sms_surface.db
